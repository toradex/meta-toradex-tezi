{
    "description": "Tezi master floating development setup",
    "sources": {
        "bitbake": {
            "git-remote": {
                "branch": "master",
                "rev": "master",
                "uri": "https://git.openembedded.org/bitbake"
            }
        },
        "meta-arm": {
            "git-remote": {
                "branch": "master",
                "rev": "master",
                "uri": "https://git.yoctoproject.org/meta-arm"
            }
        },
        "meta-freescale": {
            "git-remote": {
                "branch": "master",
                "rev": "master",
                "uri": "https://github.com/Freescale/meta-freescale.git"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "branch": "master",
                "rev": "master",
                "uri": "https://git.openembedded.org/meta-openembedded"
            }
        },
        "meta-qcom": {
            "git-remote": {
                "branch": "master",
                "rev": "master",
                "uri": "https://github.com/qualcomm-linux/meta-qcom.git"
            }
        },
        "meta-qt5": {
            "git-remote": {
                "branch": "master",
                "rev": "master",
                "uri": "https://github.com/meta-qt5/meta-qt5.git"
            }
        },
        "meta-ti": {
            "git-remote": {
                "branch": "master",
                "rev": "master",
                "uri": "https://git.yoctoproject.org/meta-ti"
            }
        },
        "meta-toradex-bsp": {
            "git-remote": {
                "branch": "main",
                "rev": "main",
                "uri": "https://git.toradex.com/meta-toradex-bsp.git"
            }
        },
        "meta-toradex-tezi": {
            "git-remote": {
                "branch": "master",
                "rev": "master",
                "uri": "https://github.com/toradex/meta-toradex-tezi.git"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "branch": "master",
                "rev": "master",
                "uri": "https://git.openembedded.org/openembedded-core"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "bb-layers": [
                    "meta-arm/meta-arm",
                    "meta-arm/meta-arm-toolchain",
                    "meta-freescale",
                    "meta-openembedded/meta-filesystems",
                    "meta-openembedded/meta-multimedia",
                    "meta-openembedded/meta-networking",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-python",
                    "meta-qcom",
                    "meta-qt5",
                    "meta-ti/meta-ti-bsp",
                    "meta-toradex-bsp/meta-toradex-bsp-common",
                    "meta-toradex-bsp/meta-toradex-nxp",
                    "meta-toradex-bsp/meta-toradex-qcom",
                    "meta-toradex-bsp/meta-toradex-ti",
                    "meta-toradex-tezi",
                    "openembedded-core/meta"
                ],
                "name": "tdxref-floating",
                "description": "Tezi development layer stack with floating sources",
                "notes": [
                    "Tezi targets are:",
                    "    tezi-run",
                    "    tezi-devel",
                    "    targets may be found in",
                    "    meta-toradex-tezi/recipes-tezi/images/"
                ],
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machine",
                        "options": [
                            "machine/apalis-imx6",
                            "machine/apalis-imx8",
                            "machine/aquila-am69",
                            "machine/aquila-imx95",
                            "machine/colibri-imx6",
                            "machine/colibri-imx6ull",
                            "machine/colibri-imx7",
                            "machine/colibri-imx8x",
                            "machine/lino-imx93",
                            "machine/toradex-osm-imx93",
                            "machine/toradex-osm-imx95",
                            "machine/toradex-smarc-imx8mp",
                            "machine/toradex-smarc-imx95",
                            "machine/verdin-am62",
                            "machine/verdin-am62p",
                            "machine/verdin-imx8mm",
                            "machine/verdin-imx8mp",
                            "machine/verdin-imx95"
                        ]
                    },
                    "accept-fsl-eula": {
                        "description": "Accept the FSL EULA",
                        "options": [
                            {
                                "name": "freescale-layer/eula/accept-fsl-eula",
                                "description": "Required to build recipes that use proprietary NXP software."
                            },
                            {
                                "name": "",
                                "description": "Do not accept the FSL EULA"
                            }
                        ]
                    }
                },
                "oe-fragments": [
                    "distro/tezi",
                    "toradex-bsp-common-layer/floating-bsp-sources",
                    "toradex-bsp-common-layer/toradex-deploy-layout",
                    "toradex-tezi/floating-tezi-sources"
                ],
                "setup-dir-name": "tezi-master"
            }
        ]
    },
    "version": "1.0"
}
